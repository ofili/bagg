# Database (Postgres container mapped to host port 5433 to avoid native conflicts)
DATABASE_URL=postgresql+asyncpg://bagg:baggpassword@localhost:5433/bagg_dev
SYNC_DATABASE_URL=postgresql+psycopg2://bagg:baggpassword@localhost:5433/bagg_dev

# Redis & Jobs
REDIS_URL=redis://localhost:6379/0

# App Settings
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-super-secret-key-at-least-32-chars
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Email (Mailpit for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=invoices@bagg.app

# Object Storage (MinIO for local development)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_NAME=bagg-uploads
S3_REGION=us-east-1

# External Payment Processors (for testing / Phase 1)
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-placeholder
